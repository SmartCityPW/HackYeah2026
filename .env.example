# Skopiuj do `.env` (plik jest w .gitignore) i uzupełnij. To jedyne miejsce na SEKRETY.
# Wszystkie pozostałe ustawienia leżą w backend/config/*.yaml.

DJANGO_SECRET_KEY=
DB_PASSWORD=
# Klucz usługi agenta moderującego (potrzebny tylko, gdy moderation.provider = http)
AI_API_KEY=
# Hasło kont demo (manage.py seed_demo, tylko tryb debug)
DEMO_PASSWORD=

# Opcjonalne parametry uruchomienia (nie sekrety):
# BACKEND_PORT=8000                         # port na hoście
# APP_CONFIG_OVERRIDE=config/production.yaml  # dodatkowy plik YAML scalany z default.yaml
# POSTGRES_IMAGE=postgres:16
# PYTHON_VERSION=3.13
