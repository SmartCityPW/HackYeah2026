# Skopiuj do `.env` (plik jest w .gitignore) i uzupełnij. To jedyne miejsce na SEKRETY.
# Wszystkie pozostałe ustawienia leżą w backend/config/*.yaml.

DJANGO_SECRET_KEY=
DB_PASSWORD=
# Klucz agenta moderującego (potrzebny tylko, gdy moderation.provider = http albo gemini; klucz Google AI Studio / Gemini API)
AI_API_KEY=
# Hasło konta administratora IT (adres w backend/config/default.yaml: admin.email). Konto powstaje przy starcie backendu;
# istniejącemu kontu hasło nie jest zmieniane. Bez tej zmiennej konto administratora nie powstaje.
ADMIN_PASSWORD=
# Hasło kont demo (manage.py seed_demo, tylko tryb debug)
DEMO_PASSWORD=

# Opcjonalne parametry uruchomienia (nie sekrety):
# BACKEND_PORT=8000                         # port backendu na hoście
# FRONTEND_PORT=4200                        # port aplikacji na hoście; musi być na liście app.cors_allowed_origins (backend/config/default.yaml)
# APP_CONFIG_OVERRIDE=config/production.yaml  # dodatkowy plik YAML scalany z default.yaml
# APP_CONFIG_OVERRIDE=config/demo.example.yaml  # dane demo w Dockerze (wymaga DEMO_PASSWORD)
# APP_CONFIG_OVERRIDE=config/gemini.example.yaml  # moderacja przez Gemini (wymaga AI_API_KEY)
# APP_CONFIG_OVERRIDE=config/demo.example.yaml,config/gemini.example.yaml  # kilka plików po przecinku: demo + Gemini
# POSTGRES_IMAGE=postgres:16
# PYTHON_VERSION=3.13
# NODE_VERSION=24                           # obraz budujący frontend
# FRONTEND_CONFIG=app-config.yaml             # domyślnie app-config.production.yaml (bez narzędzi deweloperskich); .yaml = z symulatorem GPS
# DOMAIN=twoja-domena.example                 # tylko z profilem tls (Caddy, HTTPS): docker compose --profile tls up -d --build
# Wdrożenie: skopiuj backend/config/production.example.yaml do production.yaml i ustaw APP_CONFIG_OVERRIDE=config/production.yaml
